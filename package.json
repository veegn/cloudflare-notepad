{
  "name": "cloudflare-notepad",
  "version": "1.0.0",
  "author": "veegn",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.58.2",
    "@types/js-yaml": "^4.0.9",
    "esbuild": "^0.25.1",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "wrangler": "^4.33.1"
  },
  "private": true,
  "scripts": {
    "prestart": "npm run build:frontend:dev",
    "start": "wrangler dev",
    "predeploy": "npm run build:frontend:prod",
    "deploy": "wrangler deploy",
    "pretest:e2e": "npm run build:frontend:dev",
    "test:e2e": "playwright test",
    "build:frontend": "npm run build:frontend:prod",
    "build:frontend:dev": "node scripts/build-frontend.mjs dev",
    "build:frontend:prod": "node scripts/build-frontend.mjs prod",
    "typecheck": "tsc --noEmit",
    "lint": "eslint frontend/**/*.ts",
    "check": "npm run lint && npm run typecheck && cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.12.2",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.17",
    "dayjs": "^1.11.19",
    "dompurify": "^3.3.3",
    "js-yaml": "^4.1.1",
    "marked": "^17.0.4",
    "marked-alert": "^2.1.2"
  }
}
