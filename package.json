{
  "name": "cloudflare-notepad",
  "version": "1.0.0",
  "author": "veegn",
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "overrides": {
    "minimatch@10": "11.0.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "mermaid": "12.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "wrangler": "^4.158.0"
  },
  "private": true,
  "scripts": {
    "prestart": "npm run build:frontend:dev",
    "start": "wrangler dev",
    "predeploy": "npm run build:frontend:prod",
    "deploy": "wrangler deploy",
    "pretest:e2e": "npm run build:frontend:dev",
    "test:e2e": "playwright test",
    "build:frontend": "npm run build:frontend:prod",
    "build:frontend:dev": "tsx scripts/build-frontend.mts dev",
    "build:frontend:prod": "tsx scripts/build-frontend.mts prod",
    "typecheck": "tsc --noEmit",
    "lint": "eslint frontend tests scripts playwright.config.ts",
    "check": "npm run lint && npm run typecheck && cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test",
    "adopt:book": "tsx --no-warnings=ExperimentalWarning scripts/adopt-book.mts",
    "repair": "tsx --no-warnings=ExperimentalWarning scripts/repair-doc.mts",
    "cleanup:e2e": "tsx --no-warnings=ExperimentalWarning scripts/cleanup-e2e.mts",
    "migrate:doctype": "tsx --no-warnings=ExperimentalWarning scripts/migrate-doctype.mts",
    "migrate:doctype:dry": "tsx --no-warnings=ExperimentalWarning scripts/migrate-doctype.mts --dry-run",
    "migrate:kv-to-r2": "tsx --no-warnings=ExperimentalWarning scripts/migrate-kv-to-r2.mts",
    "migrate:kv-to-r2:dry": "tsx --no-warnings=ExperimentalWarning scripts/migrate-kv-to-r2.mts --dry-run"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.17",
    "js-yaml": "^4.3.2",
    "marked": "^18.1.3",
    "marked-alert": "^2.1.2"
  }
}
