{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "allowJs": false,
    "isolatedModules": true
  },
  "include": ["frontend/**/*.ts", "frontend/**/*.d.ts"]
}
